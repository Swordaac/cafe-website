{
  "name": "cafe-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:stripe": "tsx scripts/test-stripe.ts",
    "setup:stripe": "tsx scripts/setup-test-stripe.ts",
    "debug:stripe": "tsx scripts/test-payment-debug.ts",
    "fix:stripe": "tsx scripts/fix-tenant-stripe.ts",
    "quick:fix": "tsx scripts/quick-fix-stripe.ts",
    "set:tenant:stripe": "tsx scripts/set-tenant-stripe.ts",
    "enable:card-payments": "tsx scripts/enable-card-payments.ts",
    "test:payment": "tsx scripts/test-payment-endpoint.ts",
    "migrate:food": "tsx scripts/migrate-food-products.ts",
    "migrate:food:simple": "tsx scripts/migrate-food-simple.ts",
    "upload:images": "tsx scripts/upload-images.ts",
    "test:products": "tsx scripts/test-api.ts",
    "test:rate-limit": "node scripts/test-rate-limit-simple.js",
    "test:rate-limit-ts": "tsx scripts/test-rate-limit.ts",
    "test:rate-limit-quick": "node scripts/quick-rate-test.js",
    "cleanup:migrate": "tsx scripts/cleanup-and-migrate.ts",
    "create-membership": "tsx scripts/create-test-membership.ts",
    "debug:loyalty": "tsx scripts/debug-loyalty.ts"
  },
  "dependencies": {
    "cloudinary": "^2.7.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "helmet": "^7.1.0",
    "jose": "^5.9.3",
    "mongodb": "^6.20.0",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "stripe": "^19.1.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.6.3"
  }
}
